<?xml version="1.0" encoding="utf-8"?>
<!--
  نص مفرد بخط سَكِينَة. يُستخدم مع RemoteViews.setTextViewText /
  setTextColor / setTextViewTextSize — كلها API 1، تعمل على minSdk 24.
  الخط يُضبط عبر android:fontFamily في XML مباشرة (res/font مدعوم من API 26
  وAppCompat يدعمه تنازليًا؛ لضمان الأمان على API 24-25 نستخدم
  ResourcesCompat.getFont عبر setTypeface في الـ fallback أدناه).
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:ellipsize="end"
    android:padding="0dp"
    android:fontFamily="@font/thmanyah_sans_regular"
    android:textDirection="rtl" />
