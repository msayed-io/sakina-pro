<?xml version="1.0" encoding="utf-8"?>
<!--
  معاينة منتقي الويدجت — تُبنى من **نفس** التخطيطات المستخدمة في العرض
  الحقيقي (widget_top_row + widget_times_row)، فلا يمكن أن تنحرف عن
  التصميم المعتمد. المحتوى هنا أمثلة ثابتة فقط (المواصفات §1):
  البيانات الحقيقية تأتي من PrayerAlarmStore وقت العرض.

  الألوان من الثيم الحي (@color/sk_w_*) فتتبدّل تلقائيًا مع الوضع.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp"
    android:layoutDirection="rtl">

    <include layout="@layout/widget_top_row_preview" />

    <include
        layout="@layout/widget_times_row"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp" />
</LinearLayout>
