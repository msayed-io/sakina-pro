<?xml version="1.0" encoding="utf-8"?>
<!--
  البطاقة الكاملة — نسخة حرفية من DOM الـ HTML:

    .widget      width:100%; max-width:360px; border-radius:28px;
                 background:var(—bg);
                 padding:14px 16px 12px;        ← أعلى 14 · جانبان 16 · أسفل 12
                 display:flex; flex-direction:column; gap:10px

  ارتفاع البطاقة بالمقاييس الحقيقية لخطوطنا = 159.7dp:
      14 (حشوة أعلى) + 77.7 (صف علوي) + 10 (فاصل) + 46 (بلاطات) + 12 (أسفل)
  الصف العلوي 77.7 لا 72: الوصفية 15 + الاسم 43.5 + «التالية» 16.25 + الهوامش.

  ⚠️ layout_height = wrap_content وليس match_parent.
  السبب الجذري للفراغ السفلي في الصورة الحقيقية: الجذر كان match_parent
  (مع fillMaxSize في Glance) فيأخذ كل ارتفاع الخلية — قياس فعلي: البطاقة
  400dp والمحتوى 154dp ⇒ 246dp فراغ. التصميم في CSS عمود flex بارتفاع
  تلقائي، فالبطاقة ترتفع بمقدار محتواها فقط ولا تتمدّد أبدًا.

  المسافة 10dp بين الصفين = marginTop على شريط المواقيت.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp"
    android:layoutDirection="rtl">

    <include layout="@layout/widget_top_row" />

    <!-- gap:10px -->
    <include
        layout="@layout/widget_times_row"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp" />
</LinearLayout>
