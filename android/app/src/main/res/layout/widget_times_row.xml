            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="العصر"
            android:textSize="10.5sp"
            android:fontFamily="@font/thmanyah_sans_regular"
            android:textColor="@color/sk_w_text2" />

        <TextView
