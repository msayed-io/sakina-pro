            android:textDirection="ltr" />
    </LinearLayout>
    <!-- ═══ المغرب ═══ -->
    <LinearLayout
        android:id="@+id/w_tile_maghrib"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_tile_bg"
        android:layout_marginStart="5dp">

        <TextView
            android:id="@+id/w_tile_maghrib_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="المغرب"
            android:textSize="10.5sp"
            android:fontFamily="@font/thmanyah_sans_regular"
            android:textColor="@color/sk_w_text2" />

        <TextView
            android:id="@+id/w_tile_maghrib_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="13.5sp"
            android:fontFamily="@font/thmanyah_sans_bold"
            android:textColor="@color/sk_w_text"
            android:textDirection="ltr" />
    </LinearLayout>
    <!-- ═══ العشاء ═══ -->
    <LinearLayout
        android:id="@+id/w_tile_isha"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_tile_bg"
        android:layout_marginStart="5dp">

        <TextView
            android:id="@+id/w_tile_isha_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="العشاء"
            android:textSize="10.5sp"
            android:fontFamily="@font/thmanyah_sans_regular"
            android:textColor="@color/sk_w_text2" />

        <TextView
            android:id="@+id/w_tile_isha_time"
            android:layout_width="wrap_content"
