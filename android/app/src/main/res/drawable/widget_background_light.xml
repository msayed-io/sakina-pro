<?xml version="1.0" encoding="utf-8"?>
<!--
  سطح cut-crystal-satin — الوضع الفاتح.
  المصدر: src/index.css:234-238  linear-gradient(180deg, rgba(253,252,251,.93), rgba(248,245,240,.86))
  RemoteViews لا يدعم backdrop-filter؛ نقارب المادة بسطح متدرّج + زاوية 26dp.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#EDFDFCFB"
        android:centerColor="#F2F8F5F0"
        android:endColor="#DBF8F5F0"
        android:type="linear" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="#142B1A10" />
</shape>
