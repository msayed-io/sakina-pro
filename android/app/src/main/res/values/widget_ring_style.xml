<?xml version="1.0" encoding="utf-8"?>
<!--
  نمط الحلقة.

  ⚠️ تحقق حرج: startAngle / endAngle ليستا سمتَي android:attr، بل
  عنصران في R.styleable فقط. وضعهما داخل <style> ينتج
  "style attribute 'android:attr/startAngle' not found" ويفشل ربط
  الموارد (حدث فعليًا في CI #44683440624).

  الحل: نضعهما كسمات مباشرة على عنصر ProgressBar في التخطيط، حيث
  تُقرأ من ProgressBar_startAngle/endAngle وليست من Android attr.

  أيضًا: background هنا هو مسار الحلقة الخلفي — نستخدم ring shape
  بـ useLevel=false فلا يتأثر بالـ progress.
-->
<resources>
    <style name="WidgetRing" parent="android:style/Widget.ProgressBar">
        <item name="android:progressDrawable">@drawable/widget_ring_arc</item>
        <item name="android:background">@drawable/widget_ring_track</item>
        <item name="android:max">1000</item>
        <item name="android:indeterminate">false</item>
        <item name="android:interpolator">@android:anim/linear_interpolator</item>
    </style>
</resources>
