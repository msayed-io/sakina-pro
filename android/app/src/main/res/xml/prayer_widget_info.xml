<?xml version="1.0" encoding="utf-8"?>
<!--
  prayer_widget_info.xml — المواصفات §1 (الحجم والشبكة).

  «المقاس الحقيقي 4×2 مضغوط (لأن صفين لا يتسعان في خلية واحدة)»
    • targetCellWidth  = 4
    • targetCellHeight = 2
    • minResizeHeight  = maxResizeHeight  → لا تمدد رأسي إطلاقًا
    • resizeMode = "horizontal"           → التمدد أفقي فقط
  فيبقى المحتوى (≈154dp) ملتصقًا بحدود الشبكة بلا فراغ سفلي.

  minHeight 154dp = ارتفاع المحتوى المحسوب من التصميم:
      14 (حشوة أعلى) + 72 (صف علوي) + 10 (فاصل) + 46 (بلاطات) + 12 (أسفل) = 154

  updatePeriodMillis = 0 — لا wakeup دوري من النظام.
  التحديث: أحداث التطبيق (updateAll) + منبّه غير دقيق كل 10 دقائق
  للحلقة فقط (المواصفات §4، قرار المستخدم الصريح).

  widgetCategory = home_screen|keyguard — الشاشة الرئيسية وشاشة القفل.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="154dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="250dp"
    android:minResizeHeight="154dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="154dp"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen|keyguard"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/prayer_widget_preview"
    android:description="@string/widget_description"
    android:updatePeriodMillis="0" />
