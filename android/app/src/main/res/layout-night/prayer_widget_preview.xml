<?xml version="1.0" encoding="utf-8"?>
<!--
  prayer_widget_preview.xml — معاينة منتقي الويدجت (الوضع الداكن).
  نسخة ثابتة من DetailedLayout بنفس: المادة، الحلقة، التواريخ، المواقيت.
  المرجع: PrayerWidgetContent.kt (DetailedLayout) و App.tsx:1224-1290.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background_dark"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:layoutDirection="rtl">

    <!-- ═══ الرأس: الصلاة الحالية + الحلقة ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="الصلاة الحالية"
                android:textSize="10sp"
                android:fontFamily="@font/thmanyah_sans_bold"
                android:textColor="#99EBEBF5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="الفجر"
                android:textSize="24sp"
                android:fontFamily="@font/thmanyah_serif_display_black"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="التالية: الشروق"
                android:textSize="10sp"
                android:fontFamily="@font/thmanyah_sans_bold"
                android:textColor="#EEDFC2" />
        </LinearLayout>

        <!-- الحلقة 80dp بنفس هندسة الأصل -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="8dp">

            <ProgressBar
                style="@style/WidgetRing"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:progressDrawable="@drawable/widget_ring_arc"
                android:background="@drawable/widget_ring_track"
                android:progress="720"
                android:max="1000"
                android:indeterminate="false" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="متبقي"
                    android:textSize="7sp"
                    android:fontFamily="@font/thmanyah_sans_bold"
                    android:textColor="#99EBEBF5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:text="٠١:٢٤:٣٠"
                    android:textSize="11sp"
                    android:fontFamily="@font/thmanyah_sans_bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#99545458" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        android:text="الزقازيق"
        android:textSize="9.5sp"
        android:fontFamily="@font/thmanyah_sans_bold"
        android:textColor="#99EBEBF5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView style="@style/PreviewCellNight" android:text="الفجر" />
        <TextView style="@style/PreviewCellNight" android:text="الشروق" />
        <TextView style="@style/PreviewCellNight" android:text="الظهر" />
        <TextView style="@style/PreviewCellAccentNight" android:text="العصر" />
        <TextView style="@style/PreviewCellNight" android:text="المغرب" />
        <TextView style="@style/PreviewCellNight" android:text="العشاء" />
    </LinearLayout>
</LinearLayout>
